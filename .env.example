# Public operator settings only. Copy to .env for a new installation.
# Connections are simultaneous proxy sockets, including setup; they are not users/devices.
# 128 is the historic unvalidated fallback, not a measured recommendation.
# Leave this variable unset to preserve an existing stored maxConnections value.
# Setting it here explicitly overrides that stored value; see docs/proxy-capacity.md.
STARGATE_MAX_CONNECTIONS=128
# App container budget covers both proxy and manager JVMs; Tor/I2P/Nym have separate budgets.
STARGATE_APP_MEMORY_LIMIT=512m
# Recreate only app using the same project, env files and complete Compose configuration.
# Regenerate resolved remote configuration first; see docs/proxy-capacity.md.
# Compose restart does not reload .env or update the memory limit.
