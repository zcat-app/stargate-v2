+	// Acknowledge the parsed snapshot only after native cleanup. This is not network readiness.
+	void ClientContext::AcknowledgeTunnels (const std::string& generation)
+	{
+		if (generation.empty ()) return;
+		std::string path; i2p::config::GetOption ("tunconf", path);
+		if (path.empty ()) path = i2p::fs::DataDirPath ("tunnels.conf");
+		path += ".applied";
+		auto temp = path + ".XXXXXX";
+		int fd = mkstemp (temp.data ()); // private exclusive file; never follow a pre-existing temp symlink
+		if (fd < 0) return;
+		auto text = generation + " " + std::to_string (getpid ()) + "\n";
+		size_t offset = 0;
+		while (offset < text.size ())
+		{
+			auto count = write (fd, text.data () + offset, text.size () - offset);
+			if (count < 0 && errno == EINTR) continue;
+			if (count <= 0) break;
+			offset += count;
+		}
+		bool success = close (fd) == 0 && offset == text.size ();
+		std::error_code error;
+		if (success) std::filesystem::rename (temp, path, error);
+		if (!success || error) std::filesystem::remove (temp, error);
+	}
