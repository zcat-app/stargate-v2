+// Register every fragment before polling any forwarding operation. Its first send (or
+// even its ACK) may immediately enqueue an action through another sender on this FIFO.
+pub(super) async fn send_registered_replies(
+    action_sender: &AckActionSender,
+    shutdown_token: &ShutdownToken,
+    pending_acks: Vec<PendingAcknowledgement>,
+    forward: impl std::future::Future<Output = ()>,
+) {
+    if let Err(err) = action_sender.unbounded_send(Action::new_insert(pending_acks)) {
+        if !shutdown_token.is_cancelled() {
+            error!("Failed to send insert action to the controller: {err}");
+        }
+    }
+    forward.await;
+}
