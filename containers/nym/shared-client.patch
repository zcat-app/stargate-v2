+#[cfg(test)]
+mod shared_client_tests {
+    use super::*;
+
+    #[test]
+    fn removed_and_stale_lanes_clear_published_lengths_without_touching_live_lanes() {
+        let mut buffer = TransmissionBuffer::<u8>::new();
+        let mut lengths = LaneQueueLengths::new();
+        let live = TransmissionLane::ConnectionId(1);
+        buffer.buffer.insert(live, LaneBufferEntry::new(VecDeque::from([1])));
+        lengths.set(&live, Some(1));
+        for id in 2..10_002 {
+            let lane = TransmissionLane::ConnectionId(id);
+            let mut entry = LaneBufferEntry::new(VecDeque::from([2, 3]));
+            if id % 2 == 0 {
+                entry.time_for_last_activity = get_time_now() - Duration::from_secs(MSG_CONSIDERED_STALE_AFTER_SECS + 1);
+            }
+            buffer.buffer.insert(lane, entry);
+            lengths.set(&lane, Some(2));
+            if id % 2 == 0 {
+                buffer.prune_stale_connections(&mut lengths);
+            } else {
+                buffer.remove_with_queue_lengths(&lane, &mut lengths);
+            }
+            assert_eq!(lengths.get(&lane), None);
+            assert_eq!(lengths.total(), 1);
+            assert_eq!(buffer.lane_length(&live), Some(1));
+            assert_eq!(buffer.buffer.len(), 1);
+            assert_eq!(lengths.lock().unwrap().map.len(), 1);
+        }
+    }
+}
