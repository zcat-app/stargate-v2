+#[cfg(test)]
+mod shared_client_tests {
+    use super::*;
+    use crate::client::real_messages_control::message_handler::send_registered_replies;
+    use nym_sphinx::anonymous_replies::requests::AnonymousSenderTag;
+    use nym_sphinx::chunking::fragment::Fragment;
+
+    #[tokio::test]
+    async fn immediate_reply_send_starts_retry_timers_for_every_fragment() {
+        // Exercise single-SURB and multi-lane reply registration through the exact
+        // production dispatch helper. The downstream consumer signals immediately.
+        for count in [1u8, 2u8] {
+            let (actions, incoming) = mpsc::unbounded();
+            let (retransmit, mut retries) = mpsc::unbounded();
+            let mut controller = ActionController::new(
+                Config::new(Duration::from_millis(1), 1.0), retransmit, incoming);
+            let pending: Vec<_> = (1..=count).map(|id| {
+                let fragment = Fragment::try_from_bytes(&[0x80, 0, 0, id, 1, 1, 0, 42]).unwrap();
+                PendingAcknowledgement::new_anonymous(fragment,
+                    SphinxDelay::new_from_millis(0), AnonymousSenderTag::from([0u8; 16]), false, None)
+            }).collect();
+            let ids: Vec<_> = pending.iter().map(|ack| ack.inner_fragment_identifier()).collect();
+            let sent_actions = actions.clone();
+            send_registered_replies(&actions, &ShutdownToken::new(), pending, async {
+                for id in &ids {
+                    sent_actions.unbounded_send(Action::StartTimer(*id)).unwrap();
+                }
+            }).await;
+            for _ in 0..=count {
+                let action = controller.incoming_actions.next().await.unwrap();
+                controller.process_action(action);
+            }
+            assert!(ids.iter().all(|id| controller.pending_acks_data[id].1.is_some()),
+                "a first-send notification must never precede ACK registration");
+            let mut retried = Vec::new();
+            for _ in 0..count {
+                let expired = tokio::time::timeout(Duration::from_secs(1),
+                    controller.pending_acks_timers.next()).await.unwrap().unwrap();
+                controller.handle_expired_ack_timer(expired);
+                let retry = retries.next().await.unwrap().upgrade().unwrap();
+                retried.push(retry.inner_fragment_identifier());
+            }
+            assert!(ids.iter().all(|id| retried.contains(id)));
+        }
+    }
+}
